{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "LOCUS-recovery-receipt-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["payload", "signature", "version"],
  "properties": {
    "version": {"const": "LOCUS-recovery-receipt-v1"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discovery_endpoint", "discovery_profile", "initial", "issued_at", "issuer", "operator_key_id", "recovery_handle", "subject_id"],
      "properties": {
        "issuer": {"type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[!-~]+$"},
        "issued_at": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "subject_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "recovery_handle": {"type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[!-~]+$"},
        "discovery_profile": {"const": "LOCUS-account-scoped-bootstrap-v1"},
        "discovery_endpoint": {"type": "string", "minLength": 1, "maxLength": 255, "pattern": "^https://[^/?#]+/?$"},
        "operator_key_id": {"type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[!-~]+$"},
        "initial": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["backup_id", "configuration_digest", "descriptor_sha256", "epoch"],
              "properties": {
                "backup_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
                "epoch": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
                "configuration_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "descriptor_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          ]
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value", "version"],
      "properties": {
        "algorithm": {"const": "Ed25519"},
        "key_id": {"type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[!-~]+$"},
        "value": {"type": "string", "pattern": "^[0-9a-f]{128}$"},
        "version": {"const": "LOCUS-bootstrap-signature-v1"}
      }
    }
  }
}
