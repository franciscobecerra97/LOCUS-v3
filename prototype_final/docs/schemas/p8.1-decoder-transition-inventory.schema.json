{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P8.1 assurance inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["inventory_version", "scope", "status", "retained_evidence", "external_surfaces", "durable_transitions", "cross_cutting_controls"],
  "properties": {
    "inventory_version": {"const": 1},
    "scope": {"const": "prototype_final"},
    "status": {"const": "complete"},
    "retained_evidence": {"const": false},
    "external_surfaces": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/surface"}},
    "durable_transitions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/transition"}},
    "cross_cutting_controls": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/control"}}
  },
  "$defs": {
    "references": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(locus|tests)/[^:]+\\.py::.+|^tasks\\.py::.+"}},
    "surface": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "source", "decoder", "routes", "negative_tests", "authenticated_transport_tests"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"}, "source": {"type": "string", "pattern": "^locus/.+\\.py$"}, "decoder": {"type": "string", "minLength": 1},
        "routes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^/"}}, "negative_tests": {"$ref": "#/$defs/references"}, "authenticated_transport_tests": {"$ref": "#/$defs/references"}
      }
    },
    "transition": {
      "type": "object", "additionalProperties": false, "required": ["id", "source", "symbol", "tests"],
      "properties": {"id": {"type": "string", "pattern": "^[a-z0-9-]+$"}, "source": {"type": "string", "pattern": "^locus/.+\\.py$"}, "symbol": {"type": "string", "minLength": 1}, "tests": {"$ref": "#/$defs/references"}}
    },
    "control": {
      "type": "object", "additionalProperties": false, "required": ["id", "tests"],
      "properties": {"id": {"type": "string", "pattern": "^[a-z0-9-]+$"}, "tests": {"$ref": "#/$defs/references"}}
    }
  }
}
