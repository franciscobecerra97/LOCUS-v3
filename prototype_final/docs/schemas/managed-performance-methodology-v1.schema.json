    "decision_id": {"const": "D028"},
    "deployment": {"type": "object"},
    "failure_schedules": {"type": "object"},
    "format_id": {"const": "LOCUS-managed-performance-methodology-v1"},
    "limitations": {"type": "array", "minItems": 7, "maxItems": 7},
