{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:locus:recovery-suite-selector:v1",
  "title": "LOCUS recovery-suite selection v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["authorization_quorum", "authorizer_ids", "holder_ids", "k", "n", "profile_id", "suite_id", "version"],
  "properties": {
    "version": {"const": "LOCUS-recovery-suite-selector-v1"},
    "suite_id": {"enum": ["LOCUS-TPASS-YI-ZK-RISTRETTO255-v1", "LOCUS-APPSS-2HASHDH-RISTRETTO255-SHA512-GF128-v1"]},
    "profile_id": {"enum": ["LOCUS-TPASS-YI-2of3-v1", "LOCUS-APPSS-2of3-v1"]},
    "k": {"const": 2},
    "n": {"const": 3},
    "holder_ids": {"const": [1, 2, 3]},
    "authorizer_ids": {"type": "array", "minItems": 3, "maxItems": 255, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 255}},
    "authorization_quorum": {"type": "integer", "minimum": 2, "maximum": 255}
  }
}
