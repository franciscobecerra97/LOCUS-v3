{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:locus:recovery-bundle-manifest:v1",
  "title": "LOCUS recovery-bundle manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["bundle_profile", "members", "version"],
  "properties": {
    "bundle_profile": {"const": "LOCUS-recovery-bundle-v1"},
    "members": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "length", "name", "sha256"],
          "properties": {
            "format": {"type": "string", "pattern": "^[!-~]{1,255}$"},
            "length": {"type": "integer", "minimum": 1, "maximum": 1048576},
            "name": {"const": "backup.json"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "length", "name", "sha256"],
          "properties": {
            "format": {"const": "LOCUS-recovery-descriptor-v1"},
            "length": {"type": "integer", "minimum": 1, "maximum": 65536},
            "name": {"const": "descriptor.json"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      ],
      "items": false
    },
    "version": {"const": "LOCUS-recovery-bundle-manifest-v1"}
  }
}
