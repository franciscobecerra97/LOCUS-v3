{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://locus.invalid/schemas/security-matrix-v2.schema.json",
  "title": "LOCUS managed security and information-flow matrix v2 candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact",
    "predecessor",
    "phases",
    "views",
    "managed_contracts"
  ],
  "properties": {
    "artifact": {
      "const": "LOCUS-security-matrix-v2"
    },
    "predecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "sha256", "preserved_claim_ids"],
      "properties": {
        "artifact": {
          "const": "LOCUS-security-matrix-v1"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "preserved_claim_ids": {
          "type": "array",
          "minItems": 26,
          "maxItems": 26,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^C[0-9]{2}$"
          }
        }
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "views": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "managed_contracts": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contract_id",
          "phases",
          "views",
          "asset",
          "adversary",
          "assumptions",
          "boundary",
          "positive_control",
          "expected_observation",
          "interpretation_limit"
        ],
        "properties": {
          "contract_id": {
            "type": "string",
            "pattern": "^M[0-9]{2}$"
          },
          "phases": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          },
          "views": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          },
          "asset": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1500
          },
          "adversary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1500
          },
          "assumptions": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "boundary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2500
          },
          "positive_control": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2500
          },
          "expected_observation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "interpretation_limit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    }
  }
}
