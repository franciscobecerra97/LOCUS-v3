{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/locus/artifact-manifest-v2.schema.json",
  "title": "LOCUS anonymous artifact v2 manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact", "entries", "source_commit"],
  "properties": {
    "artifact": {
      "const": "LOCUS-anonymous-artifact-v2"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!\\./).+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  }
}
