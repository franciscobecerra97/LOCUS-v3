{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:locus:compose-benchmark:v1",
  "title": "LOCUS Compose benchmark result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact",
    "attempts",
    "latency_ms",
    "profile",
    "runs",
    "selected",
    "status"
  ],
  "properties": {
    "artifact": {"const": "LOCUS-compose-benchmark-v1"},
    "attempts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["after", "before", "budget"],
      "properties": {
        "after": {"type": "integer", "minimum": 0},
        "before": {"type": "integer", "minimum": 0},
        "budget": {"type": "integer", "minimum": 0}
      }
    },
    "latency_ms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max", "mean", "median", "min", "samples"],
      "properties": {
        "max": {"type": "number", "exclusiveMinimum": 0},
        "mean": {"type": "number", "exclusiveMinimum": 0},
        "median": {"type": "number", "exclusiveMinimum": 0},
        "min": {"type": "number", "exclusiveMinimum": 0},
        "samples": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    },
    "profile": {"const": "benchmark"},
    "runs": {"type": "integer", "minimum": 1, "maximum": 4},
    "selected": {"const": [1, 3]},
    "status": {"const": "ok"}
  }
}
