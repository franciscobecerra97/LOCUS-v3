{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:locus:appss-wire:v1",
  "title": "LOCUS aPPSS wire and state objects v1",
  "oneOf": [
    {"$ref": "#/$defs/publicState"},
    {"$ref": "#/$defs/partyState"},
    {"$ref": "#/$defs/pendingPartyState"},
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/response"},
    {"$ref": "#/$defs/install"},
    {"$ref": "#/$defs/ready"}
  ],
  "$defs": {
    "hex16": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "hex32": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "common": {
      "type": "object",
      "properties": {
        "suite_id": {"const": "LOCUS-APPSS-2HASHDH-RISTRETTO255-SHA512-GF128-v1"},
        "profile_id": {"const": "LOCUS-APPSS-2of3-v1"},
        "context_digest": {"$ref": "#/$defs/hex32"}
      }
    },
    "maskedShare": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "value"],
      "properties": {
        "index": {"type": "integer", "minimum": 1, "maximum": 3},
        "value": {"$ref": "#/$defs/hex16"}
      }
    },
    "publicState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commitment", "context_digest", "k", "masked_shares", "n", "omega_digest", "oprf_profile", "profile_id", "suite_id", "version"],
      "properties": {
        "version": {"const": "LOCUS-APPSS-public-state-v1"},
        "suite_id": {"const": "LOCUS-APPSS-2HASHDH-RISTRETTO255-SHA512-GF128-v1"},
        "profile_id": {"const": "LOCUS-APPSS-2of3-v1"},
        "oprf_profile": {"const": "LOCUS-APPSS-OPRF-RISTRETTO255-SHA512-v1"},
        "context_digest": {"$ref": "#/$defs/hex32"},
        "k": {"const": 2},
        "n": {"const": 3},
        "masked_shares": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/maskedShare"}},
        "commitment": {"$ref": "#/$defs/hex16"},
        "omega_digest": {"$ref": "#/$defs/hex32"}
      }
    },
    "pendingPartyState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_digest", "holder_id", "key_commitment", "oprf_key", "profile_id", "suite_id", "version"],
      "properties": {
        "version": {"const": "LOCUS-APPSS-pending-party-state-v1"},
        "suite_id": {"const": "LOCUS-APPSS-2HASHDH-RISTRETTO255-SHA512-GF128-v1"},
        "profile_id": {"const": "LOCUS-APPSS-2of3-v1"},
        "context_digest": {"$ref": "#/$defs/hex32"},
        "holder_id": {"type": "integer", "minimum": 1, "maximum": 3},
        "oprf_key": {"$ref": "#/$defs/hex32"},
        "key_commitment": {"$ref": "#/$defs/hex32"}
      }
    },
    "partyState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_digest", "holder_id", "key_commitment", "omega_digest", "oprf_key", "profile_id", "public_state_digest", "suite_id", "version"],
      "properties": {
        "version": {"const": "LOCUS-APPSS-party-state-v1"},
        "suite_id": {"const": "LOCUS-APPSS-2HASHDH-RISTRETTO255-SHA512-GF128-v1"},
        "profile_id": {"const": "LOCUS-APPSS-2of3-v1"},
        "context_digest": {"$ref": "#/$defs/hex32"},
        "holder_id": {"type": "integer", "minimum": 1, "maximum": 3},
        "oprf_key": {"$ref": "#/$defs/hex32"},
        "key_commitment": {"$ref": "#/$defs/hex32"},
        "omega_digest": {"$ref": "#/$defs/hex32"},
        "public_state_digest": {"$ref": "#/$defs/hex32"}
      }
    },
    "messageBinding": {
      "type": "object",
      "properties": {
        "session_id": {"$ref": "#/$defs/hex32"},
        "operation_id": {"$ref": "#/$defs/hex32"},
        "nonce": {"$ref": "#/$defs/hex32"},
        "admission_grant_digest": {"$ref": "#/$defs/hex32"},
        "client_proof_key_digest": {"$ref": "#/$defs/hex32"},
        "holder_id": {"type": "integer", "minimum": 1, "maximum": 3},
        "operation": {"enum": ["initialize", "recover"]}
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["admission_grant_digest", "blinded_element", "client_proof_key_digest", "context_digest", "holder_id", "nonce", "omega_digest", "operation", "operation_id", "profile_id", "session_id", "suite_id", "version"],
      "properties": {
        "version": {"const": "LOCUS-APPSS-request-v1"},
        "suite_id": {"const": "LOCUS-APPSS-2HASHDH-RISTRETTO255-SHA512-GF128-v1"},
        "profile_id": {"const": "LOCUS-APPSS-2of3-v1"},
        "context_digest": {"$ref": "#/$defs/hex32"},
        "session_id": {"$ref": "#/$defs/hex32"},
        "operation_id": {"$ref": "#/$defs/hex32"},
        "nonce": {"$ref": "#/$defs/hex32"},
        "admission_grant_digest": {"$ref": "#/$defs/hex32"},
        "client_proof_key_digest": {"$ref": "#/$defs/hex32"},
        "holder_id": {"type": "integer", "minimum": 1, "maximum": 3},
        "operation": {"enum": ["initialize", "recover"]},
        "omega_digest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/hex32"}]},
        "blinded_element": {"$ref": "#/$defs/hex32"}
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["admission_grant_digest", "client_proof_key_digest", "context_digest", "evaluated_element", "holder_id", "key_commitment", "nonce", "omega_digest", "operation", "operation_id", "profile_id", "request_digest", "session_id", "suite_id", "version"],
      "properties": {
        "version": {"const": "LOCUS-APPSS-response-v1"},
        "suite_id": {"const": "LOCUS-APPSS-2HASHDH-RISTRETTO255-SHA512-GF128-v1"},
        "profile_id": {"const": "LOCUS-APPSS-2of3-v1"},
        "context_digest": {"$ref": "#/$defs/hex32"},
        "session_id": {"$ref": "#/$defs/hex32"},
        "operation_id": {"$ref": "#/$defs/hex32"},
        "nonce": {"$ref": "#/$defs/hex32"},
        "admission_grant_digest": {"$ref": "#/$defs/hex32"},
        "client_proof_key_digest": {"$ref": "#/$defs/hex32"},
        "holder_id": {"type": "integer", "minimum": 1, "maximum": 3},
        "operation": {"enum": ["initialize", "recover"]},
        "omega_digest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/hex32"}]},
        "request_digest": {"$ref": "#/$defs/hex32"},
        "evaluated_element": {"$ref": "#/$defs/hex32"},
        "key_commitment": {"$ref": "#/$defs/hex32"}
      }
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_digest", "holder_id", "initialization_transcript_digest", "operation_id", "profile_id", "public_state", "suite_id", "version"],
      "properties": {
        "version": {"const": "LOCUS-APPSS-state-install-v1"},
        "suite_id": {"const": "LOCUS-APPSS-2HASHDH-RISTRETTO255-SHA512-GF128-v1"},
        "profile_id": {"const": "LOCUS-APPSS-2of3-v1"},
        "context_digest": {"$ref": "#/$defs/hex32"},
        "holder_id": {"type": "integer", "minimum": 1, "maximum": 3},
        "operation_id": {"$ref": "#/$defs/hex32"},
        "initialization_transcript_digest": {"$ref": "#/$defs/hex32"},
        "public_state": {"$ref": "#/$defs/publicState"}
      }
    },
    "ready": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_digest", "holder_id", "operation_id", "party_state_digest", "profile_id", "public_state_digest", "suite_id", "version"],
      "properties": {
        "version": {"const": "LOCUS-APPSS-state-ready-v1"},
        "suite_id": {"const": "LOCUS-APPSS-2HASHDH-RISTRETTO255-SHA512-GF128-v1"},
        "profile_id": {"const": "LOCUS-APPSS-2of3-v1"},
        "context_digest": {"$ref": "#/$defs/hex32"},
        "holder_id": {"type": "integer", "minimum": 1, "maximum": 3},
        "operation_id": {"$ref": "#/$defs/hex32"},
        "party_state_digest": {"$ref": "#/$defs/hex32"},
        "public_state_digest": {"$ref": "#/$defs/hex32"}
      }
    }
  }
}
